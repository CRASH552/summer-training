{
  "name": "Scheduled Joke Fetcher",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "interval": 1
            }
          ]
        }
      },
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ],
      "id": "e93f8e56-1234-4abc-8def-1234567890ab"
    },
    {
      "parameters": {
        "url": "https://official-joke-api.appspot.com/random_joke",
        "options": {}
      },
      "name": "Fetch Joke",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        450,
        300
      ],
      "id": "e93f8e56-1234-4abc-8def-1234567890cd"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a93f8e56-1234-4abc-8def-1234567890ef",
              "name": "formatted_joke",
              "value": "={{ $json.setup }} - {{ $json.punchline }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "name": "Format Joke",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [
        650,
        300
      ],
      "id": "e93f8e56-1234-4abc-8def-1234567890ef"
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Fetch Joke",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Joke": {
      "main": [
        [
          {
            "node": "Format Joke",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {}
}
