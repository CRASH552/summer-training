{
  "name": "End-to-End AI Document Processing Workflow",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://raw.githubusercontent.com/n8n-io/n8n/master/README.md",
        "options": {}
      },
      "id": "read-file",
      "name": "Receive Document (Download)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a helpful assistant. Please summarize the following document into exactly 3 bullet points:\n\n{{ $json.data }}"
      },
      "id": "llm-node",
      "name": "AI Summarizer",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        600,
        300
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {}
      },
      "id": "model",
      "name": "Gemini 2.5 Flash",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        600,
        500
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "status",
              "value": "Saved to internal database successfully",
              "type": "string"
            },
            {
              "id": "2",
              "name": "stored_summary",
              "value": "={{ $json.text }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "write-file",
      "name": "Store Result (Database)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "",
        "text": "=📄 *Document Processed!*\n\n*Summary:*\n{{ $json.stored_summary }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "notification",
      "name": "Send Telegram Notification",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1100,
        300
      ]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Receive Document (Download)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Receive Document (Download)": {
      "main": [
        [
          {
            "node": "AI Summarizer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini 2.5 Flash": {
      "ai_languageModel": [
        [
          {
            "node": "AI Summarizer",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "AI Summarizer": {
      "main": [
        [
          {
            "node": "Store Result (Database)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Store Result (Database)": {
      "main": [
        [
          {
            "node": "Send Telegram Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {}
}
